# Sorgente dati: "mastodon" (live, serve Internet) oppure "replay" (post di esempio, funziona offline)
SOURCE=mastodon
# Istanza Mastodon da cui leggere la timeline pubblica
MASTODON_URL=https://mastodon.cloud
POLL_INTERVAL=20s
# Secondi tra un post e l'altro in modalita' replay
REPLAY_DELAY=2
# Sotto questa confidenza il post e' etichettato "neutral"
NEUTRAL_THRESHOLD=0.75
# Massimo numero di messaggi Kafka per micro-batch (backpressure)
MAX_OFFSETS_PER_TRIGGER=200
# Modello Ollama per la parte generativa del RAG
OLLAMA_MODEL=qwen2.5:1.5b

# Memoria (valori per un PC con 8 GB di RAM; con 16 GB puoi raddoppiarli)
ES_HEAP=-Xms512m -Xmx512m
LOGSTASH_HEAP=-Xms256m -Xmx256m
KAFKA_HEAP=-Xms256m -Xmx256m
SPARK_DRIVER_MEMORY=1g
SPARK_CORES=2
